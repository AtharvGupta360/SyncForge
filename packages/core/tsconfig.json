{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // No DOM, no @types/node. If someone reaches for `fetch`, `process`, or
    // `setTimeout` in here, it fails to compile. The purity rule is enforced by
    // the type system, not by remembering to be disciplined.
    "types": []
  },
  "include": ["src/**/*"],
  // Test files are compiled by Vitest (via esbuild), not by `tsc --build`, so
  // they stay out of dist/ and out of the pure-core purity contract -- they may
  // import the `vitest` runtime, which the shipped code must never do.
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../shared" }]
}
